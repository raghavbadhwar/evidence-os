      "type": "number"
    },
    "ocr_confidence": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ocr Confidence"
    },
    "ocr_used": {
      "default": false,
      "title": "Ocr Used",
