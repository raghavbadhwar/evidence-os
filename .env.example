PROOFCOUNSEL_ENVIRONMENT=development
PROOFCOUNSEL_SANDBOX_MODE=local
# PROOFCOUNSEL_SANDBOX_IMAGE=ghcr.io/proofcounsel/parser-worker:latest
PROOFCOUNSEL_TENANT_ID=00000000-0000-0000-0000-000000000001
# For end-user PostgreSQL retrieval, set actor_role=user, user_id, and matter_id as applicable.
PROOFCOUNSEL_ACTOR_ROLE=service_worker
# PROOFCOUNSEL_USER_ID=00000000-0000-0000-0000-000000000002
# PROOFCOUNSEL_MATTER_ID=00000000-0000-0000-0000-000000000003
PROOFCOUNSEL_ARTIFACT_ROOT=./artifacts
PROOFCOUNSEL_DATABASE_URL=sqlite:///./artifacts/proofcounsel.db
PROOFCOUNSEL_PARSER_CONFIG=./config/parser-defaults.toml
PROOFCOUNSEL_INGEST_V2_ENABLED=false
PROOFCOUNSEL_OCR_ENABLED=false
PROOFCOUNSEL_SEMANTIC_RETRIEVAL_ENABLED=false
# Set all three semantic index fields before enabling semantic retrieval.
# PROOFCOUNSEL_SEMANTIC_INDEX_MODEL=embed-v1
# PROOFCOUNSEL_SEMANTIC_INDEX_DIMENSIONS=768
# PROOFCOUNSEL_SEMANTIC_INDEX_VERSION=2026-01
PROOFCOUNSEL_LLM_TREE_REASONING_ENABLED=false
PROOFCOUNSEL_CITATION_ENFORCEMENT_ENABLED=true
PROOFCOUNSEL_OCR_LANGUAGES=eng
# PROOFCOUNSEL_TIKA_BINARY=/opt/homebrew/bin/tika
# PROOFCOUNSEL_TIKA_JAR=/opt/proofcounsel/tika-app.jar
